# ============================================
# TalentTrack Portal - Environment Variables
# Copy to .env and customize for your setup
# ============================================

# Database
DB_ROOT_PASSWORD=rootpassword
DB_NAME=talenttrack
DB_USER=talenttrack
DB_PASSWORD=talenttrack_pass
DB_PORT=3306

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=*

# Grafana (optional monitoring)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123
